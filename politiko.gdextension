[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]
windows.debug.x86_64 = "res://rust/target/debug/politiko_gdext.dll"
windows.release.x86_64 = "res://rust/target/release/politiko_gdext.dll"
linux.debug.x86_64 = "res://rust/target/debug/libpolitiko_gdext.so"
linux.release.x86_64 = "res://rust/target/release/libpolitiko_gdext.so"
macos.debug = "res://rust/target/debug/libpolitiko_gdext.dylib"
macos.release = "res://rust/target/release/libpolitiko_gdext.dylib"
macos.debug.arm64 = "res://rust/target/debug/libpolitiko_gdext.dylib"
macos.release.arm64 = "res://rust/target/release/libpolitiko_gdext.dylib"
